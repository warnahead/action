BEGIN:VEVENT
UID:runtime/nodejs-18-eol
DTSTAMP:20261124T000000Z
DTSTART;VALUE=DATE:20250430
DTEND;VALUE=DATE:20250501
SUMMARY:Node.js 18 reached end of life
DESCRIPTION:What happens: End-of-life since 2025-04-30 in the Node.js relea
 se schedule.\nWho: Projects whose Node.js version (engines\, .nvmrc\, .nod
 e-version\, setup-node or eas.json) is 18.x\nLast verified 2026-11-24
URL:https://warnahead.pages.dev/deadlines/runtime/nodejs-18-eol/
STATUS:CONFIRMED
TRANSP:TRANSPARENT
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Node.js 18 reached end of life: in 30 days
TRIGGER:-P30D
END:VALARM

END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:GitHub Actions: ubuntu-latest moves to Ubuntu 26.04: in 7 days
TRIGGER:-P7D
END:VALARM
END:VEVENT
BEGIN:VEVENT
